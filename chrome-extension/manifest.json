{
  "manifest_version": 3,
  "name": "Talent Pool - LinkedIn Sync",
  "version": "1.0.0",
  "description": "Sync LinkedIn profile data to local talent pool",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://127.0.0.1:5055/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
